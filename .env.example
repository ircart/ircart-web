# IRCart settings, copy to .env & fill in (setup.sh creates one for you on first run)

# Admin account, created/updated on every start
ADMIN_USER=acidvegas
ADMIN_PASS=change-me-20-random-chars

# Signs login sessions, 64 random hex characters
SECRET_KEY=change-me

# Public address used in canonical links, the sitemap & social previews
SITE_URL=https://ircart.supernets.org

# 1 when served over https (marks the session cookie secure)
SECURE_COOKIES=1

# Only needed outside of docker (docker-compose.yml sets these)
#REPO=~/dev/git/ircart/ircart
#DATA=data
#PORT=20008
